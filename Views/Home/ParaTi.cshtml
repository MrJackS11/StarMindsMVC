@{
    ViewData["Title"] = "Para Ti - Muro Anónimo Universitario";
}

<div class="container-fluid px-lg-5 py-4">
    <!-- Encabezado con toque Morado / Lavanda -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge px-3 py-2 text-uppercase fw-semibold" style="background-color: #F1EDF5; color: #6D597A; border: 1px solid #D8CFE3;">
                ✦ Pizarrón Colectivo FYP
            </span>
            <h2 class="fw-bold mt-2 mb-1" style="color: #2A6F97;">Muro de Desahogo & Logros</h2>
            <p class="text-muted mb-0">Un espacio interactivo y 100% anónimo para desahogarte, compartir tus victorias y apoyarnos entre compañeros.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <span class="badge rounded-pill bg-white border text-secondary px-3 py-2 shadow-sm d-flex align-items-center gap-1">
                🔒 Sin nombres reales
            </span>
            <span class="badge rounded-pill bg-white border text-secondary px-3 py-2 shadow-sm d-flex align-items-center gap-1">
                ☕ Música ambiental activa
            </span>
        </div>
    </div>

    <!-- Pizarrón Gigante Dark Board -->
    <div class="card border-0 shadow-lg p-4 p-md-5 mb-5" style="background: radial-gradient(circle at 20% 20%, #252A34 0%, #15181E 100%); border-radius: 24px; min-height: 650px; position: relative; border: 1px solid rgba(255,255,255,0.06);">
        
        <!-- Barra de herramientas flotante -->
        <div class="p-3 rounded-4 mb-5 shadow-sm border border-secondary border-opacity-25" style="background-color: rgba(18, 21, 26, 0.85); backdrop-filter: blur(8px);">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-7">
                    <input type="text" id="postitInput" class="form-control bg-dark text-white border-secondary px-3 py-2" 
                           placeholder="Escribe una pequeña victoria, un desahogo o palabras de ánimo (máx. 140 caracteres)..." maxlength="140">
                </div>
                <div class="col-6 col-md-3">
                    <select id="postitColor" class="form-select bg-dark text-white border-secondary py-2">
                        <option value="note-purple">💜 Morado Calma</option>
                        <option value="note-yellow">💛 Amarillo Sol</option>
                        <option value="note-mint">💚 Verde Esperanza</option>
                        <option value="note-blue">💙 Azul Serenidad</option>
                        <option value="note-pink">💖 Rosa Empatía</option>
                    </select>
                </div>
                <div class="col-6 col-md-2 d-grid">
                    <button class="btn fw-semibold text-white py-2 shadow" style="background: linear-gradient(135deg, #6D597A 0%, #528788 100%); border-radius: 10px;" onclick="pegarPostIt()">
                        📌 Pegar Post-it
                    </button>
                </div>
            </div>
        </div>

        <!-- Tablero de Post-its -->
        <div class="row g-4" id="muroPostIts">
            <div class="col-6 col-md-4 col-lg-3">
                <div class="postit note-purple">
                    <p class="mb-2">"Sentir que no puedes hoy no significa que no podrás mañana. Descansa, no te rindas."</p>
                    <small class="text-muted text-end d-block">— Anónimo_UPDS</small>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <div class="postit note-yellow">
                    <p class="mb-2">"Todas las estrellas tienen una razon para brillar."</p>
                    <small class="text-muted text-end d-block">— Leo</small>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <div class="postit note-mint">
                    <p class="mb-2">"Si hoy solo lograste levantarte y salir a caminar un rato, ya es un paso enorme."</p>
                    <small class="text-muted text-end d-block">— Val</small>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <div class="postit note-blue">
                    <p class="mb-2">"Los fuertes en la fe debemos apoyar a los débiles, en vez de hacer lo que nos agrada."</p>
                    <small class="text-muted text-end d-block">— Estudiante_Cba</small>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <div class="postit note-pink">
                    <p class="mb-2">"Tu valor como persona no lo define la nota de un examen parcial."</p>
                    <small class="text-muted text-end d-block">— EstrellaSerena</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .postit {
        padding: 20px;
        min-height: 165px;
        border-radius: 6px;
        box-shadow: 0 8px 18px rgba(0,0,0,0.4);
        font-family: 'Poppins', sans-serif;
        font-size: 0.93rem;
        color: #1e1e1e;
        line-height: 1.5;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.25s ease;
        position: relative;
    }

    .postit:hover {
        transform: scale(1.08) rotate(0deg) !important;
        box-shadow: 0 14px 28px rgba(0,0,0,0.55);
        z-index: 50;
    }

    /* Colores Pastel de los Post-it */
    .note-purple { background-color: #E8D7F1; transform: rotate(-1.5deg); }
    .note-yellow { background-color: #FFF385; transform: rotate(1deg); }
    .note-mint   { background-color: #C7F9CC; transform: rotate(-2deg); }
    .note-pink   { background-color: #FFCCD5; transform: rotate(2deg); }
    .note-blue   { background-color: #CFEAFF; transform: rotate(-1deg); }
</style>

@section Scripts {
    <script>
        function pegarPostIt() {
            const input = document.getElementById('postitInput');
            const color = document.getElementById('postitColor').value;
            const texto = input.value.trim();

            if (!texto) {
                alert('Escribe un breve mensaje antes de pegarlo en el tablero.');
                return;
            }

            const muro = document.getElementById('muroPostIts');
            const col = document.createElement('div');
            col.className = 'col-6 col-md-4 col-lg-3';

            const deg = (Math.random() * 5 - 2.5).toFixed(1);
            const autorActual = '@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Anónimo")';

            col.innerHTML = `
                <div class="postit ${color}" style="transform: rotate(${deg}deg);">
                    <p class="mb-2">"${texto}"</p>
                    <small class="text-muted text-end d-block">— ${autorActual}</small>
                </div>
            `;

            muro.prepend(col);
            input.value = '';
        }
    </script>
}