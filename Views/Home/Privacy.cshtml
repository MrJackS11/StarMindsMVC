@{
    ViewData["Title"] = "Privacidad y Anonimato - Star Minds";
}

<!-- CABECERA NOCTURNA ESTRELLADA UNIFICADA -->
<section class="w-100 py-5 px-3 px-lg-5 text-white mb-4 position-relative overflow-hidden" 
         style="background: radial-gradient(circle at 80% 30%, #2A6F97 0%, #152238 65%, #0B1320 100%); border-bottom: 1px solid rgba(255,255,255,0.08);">
    
    <div style="position: absolute; top: 15%; right: 40%; font-size: 1.8rem; color: #FFF385; opacity: 0.7;">✦</div>
    <div style="position: absolute; bottom: 20%; right: 25%; font-size: 1.4rem; color: #C7F9CC; opacity: 0.65;">✦</div>

    <div class="container-fluid px-lg-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-8" data-aos="fade-right">
                <span class="badge mb-2 px-3 py-2 text-white rounded-pill shadow-sm" style="background-color: var(--verde-menta); font-size: 0.85rem;">
                    ✦ Garantía de Confidencialidad Absoluta
                </span>
                <h1 class="display-5 fw-bold mb-3 text-white" style="font-size: clamp(1.8rem, 4vw, 2.8rem);">
                    Tu privacidad es la regla número uno.
                </h1>
                <p class="lead text-white-50 mb-0 fs-5" style="max-width: 680px; line-height: 1.7;">
                    Diseñamos cada módulo para aislar tu identidad institucional. Aquí encuentras protocolos de seguridad y canales de apoyo en situaciones de crisis emocional.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end" data-aos="zoom-in" data-aos-delay="150">
                <div class="bg-white text-dark p-4 rounded-4 shadow-lg d-inline-block text-start tilt-card" style="border-left: 6px solid var(--rojo-alerta);">
                    <small class="text-muted fw-bold d-block mb-1">✦ LÍNEA DE CONTENCIÓN EMOCIONAL (Bolivia)</small>
                    <a href="tel:800113040" class="fs-3 fw-bold text-danger text-decoration-none d-block">
                        800 11 3040
                    </a>
                    <div class="small text-secondary mt-1">Llamada Gratuita • 100% Confidencial • 24 Horas</div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container-fluid px-3 px-lg-5 py-2">
    <!-- Políticas de Anonimato y Tiempos de Consulta con 3D Tilt y AOS -->
    <div class="row g-4 mb-5">
        <div class="col-md-6" data-aos="fade-up" data-aos-delay="100">
            <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white tilt-card" style="border-top: 5px solid var(--azul-serenidad) !important;">
                <div class="card-body p-0">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle p-2.5 me-3 shadow-sm d-flex align-items-center justify-content-center" 
                             style="width: 52px; height: 52px; background-color: #E8F4F8; color: var(--azul-serenidad); font-size: 1.4rem;">
                            ✦
                        </div>
                        <div>
                            <span class="badge rounded-pill px-2.5 py-0.5 small fw-semibold" style="background-color: #E8F1F5; color: var(--azul-serenidad);">Seguridad</span>
                            <h4 class="fw-bold mb-0 text-dark">Protocolo de Desestigmatización</h4>
                        </div>
                    </div>
                    <ul class="text-secondary ps-3 mb-0" style="line-height: 1.85;">
                        <li class="mb-2"><strong>Identidad disociada:</strong> Tu nombre completo y correo institucional jamás se muestran en la agenda operativa ni ante otros usuarios.</li>
                        <li class="mb-2"><strong>Visibilidad por Alias:</strong> El personal clínico únicamente te identificará por tu seudónimo confidencial (elegido por ti).</li>
                        <li class="mb-0"><strong>Notas clínicas blindadas:</strong> El expediente de cada consulta queda encriptado y exclusivo para el terapeuta tratante bajo secreto profesional.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6" data-aos="fade-up" data-aos-delay="200">
            <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white tilt-card" style="border-top: 5px solid var(--verde-menta) !important;">
                <div class="card-body p-0">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle p-2.5 me-3 shadow-sm d-flex align-items-center justify-content-center" 
                             style="width: 52px; height: 52px; background-color: #E8F5E9; color: var(--verde-menta); font-size: 1.4rem;">
                            ✦
                        </div>
                        <div>
                            <span class="badge rounded-pill px-2.5 py-0.5 small fw-semibold" style="background-color: #E2F4EE; color: var(--verde-menta);">Estructura</span>
                            <h4 class="fw-bold mb-0 text-dark">Límites y Transición de Sesiones</h4>
                        </div>
                    </div>
                    <ul class="text-secondary ps-3 mb-0" style="line-height: 1.85;">
                        <li class="mb-2"><strong>Duración estructurada:</strong> Consultas terapéuticas exactas de 45 minutos para maximizar el foco y la efectividad.</li>
                        <li class="mb-2"><strong>Pausa de descompresión:</strong> 15 minutos obligatorios entre citas para evitar cruces en pasillos y proteger la privacidad.</li>
                        <li class="mb-0"><strong>Libertad de anulación:</strong> Cancela desde tu panel sin penalización para liberar el espacio a otro compañero.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN: COMPRENDIENDO LO QUE SIENTES -->
    <div class="mb-4" data-aos="fade-up">
        <span class="badge px-3 py-1.5 rounded-pill fw-semibold shadow-sm" style="background-color: #E8F4F8; color: var(--azul-serenidad); font-size: 0.85rem;">
            ✦ Psicoeducación Libre
        </span>
        <h2 class="fw-bold mt-2 text-dark display-6">Comprendiendo lo que sientes</h2>
        <p class="text-muted fs-5">Aprende a reconocer las diferencias entre el estrés cotidiano, la ansiedad y los signos que ameritan acompañamiento profesional.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="100">
            <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white tilt-card" style="border-top: 5px solid var(--azul-serenidad) !important;">
                <div class="card-body p-0 d-flex flex-column justify-content-between">
                    <div>
                        <span class="badge px-3 py-1 rounded-pill small fw-semibold mb-2" style="background-color: #E1F0FA; color: #0E486B;">
                            ✦ Respuesta de Alarma
                        </span>
                        <h5 class="fw-bold mb-3" style="color: var(--azul-serenidad);">Ansiedad y Pánico</h5>
                        <p class="small text-secondary mb-3" style="line-height: 1.6;">
                            Respuesta anticipatoria de alarma intensa ante exámenes, defensas de grado o alta exigencia académica.
                        </p>
                        <h6 class="fw-bold text-dark small mb-2">Señales comunes:</h6>
                        <ul class="small text-muted ps-3 mb-3" style="line-height: 1.7;">
                            <li>Palpitaciones aceleradas o sensación de ahogo.</li>
                            <li>Pensamientos catastróficos recurrentes.</li>
                            <li>Dificultad prolongada para conciliar el sueño.</li>
                        </ul>
                    </div>
                    <div class="p-3 rounded-3 bg-light border text-muted small mt-2">
                        <strong class="text-dark">Técnica Táctica 4x4:</strong> Inhala en 4s, retén en 4s, exhala en 4s y pausa en 4s.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="200">
            <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white tilt-card" style="border-top: 5px solid var(--verde-menta) !important;">
                <div class="card-body p-0 d-flex flex-column justify-content-between">
                    <div>
                        <span class="badge px-3 py-1 rounded-pill small fw-semibold mb-2" style="background-color: #E2F4EE; color: #155743;">
                            ✦ Estado Afectivo
                        </span>
                        <h5 class="fw-bold mb-3" style="color: var(--verde-menta);">Depresión y Apatía</h5>
                        <p class="small text-secondary mb-3" style="line-height: 1.6;">
                            Estado persistente de desánimo que apaga la energía, la concentración y el placer por actividades habituales.
                        </p>
                        <h6 class="fw-bold text-dark small mb-2">Señales comunes:</h6>
                        <ul class="small text-muted ps-3 mb-3" style="line-height: 1.7;">
                            <li>Pérdida de interés en la carrera o amistades.</li>
                            <li>Fatiga extrema que no se repara descansando.</li>
                            <li>Sentimientos frecuentes de culpa o inutilidad.</li>
                        </ul>
                    </div>
                    <div class="p-3 rounded-3 bg-light border text-muted small mt-2">
                        <strong class="text-dark">Estrategia Clínica:</strong> Aplica micro-pasos de 5 min para activar la motivación.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="300">
            <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white tilt-card" style="border-top: 5px solid var(--rojo-alerta) !important;">
                <div class="card-body p-0 d-flex flex-column justify-content-between">
                    <div>
                        <span class="badge px-3 py-1 rounded-pill small fw-semibold mb-2" style="background-color: #FDE8E8; color: #8A1616;">
                            ✦ Sobrecarga Crónica
                        </span>
                        <h5 class="fw-bold mb-3" style="color: var(--rojo-alerta);">Burnout Académico</h5>
                        <p class="small text-secondary mb-3" style="line-height: 1.6;">
                            Agotamiento derivado de semanas continuas de exigencia sin espacios reales de desconexión ni descanso.
                        </p>
                        <h6 class="fw-bold text-dark small mb-2">Señales comunes:</h6>
                        <ul class="small text-muted ps-3 mb-3" style="line-height: 1.7;">
                            <li>Desapego o cinismo hacia los estudios.</li>
                            <li>Bloqueos mentales al momento de rendir pruebas.</li>
                            <li>Irritabilidad recurrente con compañeros y familia.</li>
                        </ul>
                    </div>
                    <div class="p-3 rounded-3 bg-light border text-muted small mt-2">
                        <strong class="text-dark">Higiene Cognitiva:</strong> Pausas obligatorias de 15 min sin pantallas cada 90 min.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>