@model StarMindsMVC.Models.RegistrarNotaViewModel
@{
    ViewData["Title"] = "Nota Clínica Confidencial";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <span class="badge bg-danger mb-2">Secreto Profesional - Acceso Restringido</span>
                <h4 class="mb-0 fw-bold" style="color: #2A6F97;">Expediente de Sesión</h4>
                <p class="text-muted small mb-0">Paciente: <strong>@Model.AliasEstudiante</strong> | Fecha: @Model.FechaCita.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="RedactarNota" method="post">
                    <input type="hidden" asp-for="CitaId" />
                    <input type="hidden" asp-for="AliasEstudiante" />
                    <input type="hidden" asp-for="FechaCita" />

                    <div class="mb-3">
                        <label asp-for="Contenido" class="form-label fw-bold"></label>
                        <textarea asp-for="Contenido" class="form-control" rows="8" maxlength="1000" 
                                  placeholder="Registre observaciones terapéuticas, intervenciones y compromisos para la próxima sesión (máx. 1000 caracteres)..." 
                                  id="notaArea"></textarea>
                        <span asp-validation-for="Contenido" class="text-danger small"></span>
                        <div class="d-flex justify-content-between text-muted small mt-1">
                            <span>Esta nota es estrictamente invisible para el estudiante.</span>
                            <span id="charCounter">0 / 1000 caracteres</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Agenda" class="btn btn-outline-secondary">Volver a la Agenda</a>
                        <button type="submit" class="btn text-white" style="background-color: #52B788;">Guardar Nota Clínica</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const textarea = document.getElementById('notaArea');
        const counter = document.getElementById('charCounter');
        function updateCount() {
            counter.innerText = `${textarea.value.length} / 1000 caracteres`;
        }
        textarea.addEventListener('input', updateCount);
        updateCount();
    </script>
}