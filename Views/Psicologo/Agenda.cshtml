@model IEnumerable<StarMindsMVC.Models.AgendaPsicologoViewModel>
@{
    ViewData["Title"] = "Agenda Terapéutica - Star Minds";
}

<!-- CABECERA NOCTURNA ESTRELLADA UNIFICADA -->
<section class="w-100 py-4 py-md-5 px-3 px-lg-5 text-white mb-4" 
         style="background: radial-gradient(circle at 75% 25%, #2A6F97 0%, #152238 65%, #0B1320 100%); border-bottom: 1px solid rgba(255,255,255,0.08); position: relative;">
    
    <div style="position: absolute; top: 20%; right: 25%; font-size: 1.6rem; color: #FFF385; opacity: 0.65;">✦</div>
    <div style="position: absolute; bottom: 25%; right: 15%; font-size: 1.4rem; color: #C7F9CC; opacity: 0.7;">✦</div>

    <div class="container-fluid px-lg-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge mb-2 px-3 py-2 text-white rounded-pill fw-semibold shadow-sm" style="background-color: var(--azul-serenidad); font-size: 0.85rem;">
                    Panel Clínico Profesional
                </span>
                <h1 class="display-6 fw-bold mb-1 text-white" style="font-size: clamp(1.6rem, 3.5vw, 2.4rem);">
                    Agenda Terapéutica
                </h1>
                <p class="text-white-50 mb-0" style="font-size: 1.05rem;">
                    Especialista: <span class="text-white fw-semibold">@(ViewBag.NombrePsicologo ?? User.Identity?.Name ?? "Especialista")</span> • Bloques de 45 min con pausas de 15 min.
                </p>
            </div>
            
            <div class="d-flex gap-2">
                <div class="bg-white bg-opacity-10 border border-white border-opacity-25 px-4 py-2 rounded-4 text-center">
                    <span class="d-block small text-white-50">Total Citas</span>
                    <span class="fs-4 fw-bold text-white">@(Model?.Count() ?? 0)</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CONTENEDOR DE LA TABLA CLÍNICA -->
<div class="container-fluid px-3 px-lg-5 py-2">
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <span>✔ @TempData["Exito"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4 mb-5" style="border-top: 4px solid var(--azul-serenidad) !important;">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <h5 class="fw-bold mb-0 text-dark">Sesiones Programadas</h5>
                <small class="text-muted">La identidad del paciente se encuentra aislada bajo protocolo de alias.</small>
            </div>
            <span class="badge px-3 py-2 rounded-pill" style="background-color: #E8F4F8; color: var(--azul-serenidad); font-weight: 600;">
                🔒 Secreto Médico Garantizado
            </span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th scope="col" class="py-3 ps-3">Fecha y Horario</th>
                            <th scope="col" class="py-3">Paciente (Alias)</th>
                            <th scope="col" class="py-3">Modalidad</th>
                            <th scope="col" class="py-3">Motivo Orientativo</th>
                            <th scope="col" class="py-3 text-center">Estado de Cita</th>
                            <th scope="col" class="py-3 text-end pe-3">Expediente Clínico</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@item.FechaHoraInicio.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">
                                        ⏱ @item.FechaHoraInicio.ToString("HH:mm") - @item.FechaHoraFin.ToString("HH:mm")
                                    </small>
                                </td>
                                <td>
                                    <span class="badge px-3 py-2 rounded-pill fw-semibold shadow-sm" style="background-color: var(--azul-serenidad); color: #fff; font-size: 0.88rem;">
                                        ✦ @(string.IsNullOrEmpty(item.AliasEstudiante) ? "Anónimo" : item.AliasEstudiante)
                                    </span>
                                </td>
                                <td>
                                    @if (item.Modalidad == "Presencial")
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-1 rounded-pill">
                                            🏢 Presencial
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info-emphasis border border-info px-3 py-1 rounded-pill">
                                            💻 Virtual
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.EnlaceVideollamada))
                                        {
                                            <a href="@item.EnlaceVideollamada" target="_blank" class="badge bg-primary text-white text-decoration-none ms-1 px-2 py-1 rounded-pill" title="Ingresar a la videollamada">
                                                🔗 Sala
                                            </a>
                                        }
                                    }
                                </td>
                                <td style="max-width: 260px;">
                                    <span class="text-secondary small d-inline-block text-truncate w-100" title="@item.MotivoConsulta">
                                        @(string.IsNullOrEmpty(item.MotivoConsulta) ? "Orientación general" : item.MotivoConsulta)
                                    </span>
                                </td>
                                <td class="text-center" style="min-width: 170px;">
                                    <form asp-action="CambiarEstado" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="citaId" value="@item.CitaId" />
                                        <select name="nuevoEstado" class="form-select form-select-sm rounded-3 shadow-none fw-medium text-center" 
                                                onchange="this.form.submit()" 
                                                style="border-color: #d1d5db; cursor: pointer;">
                                            <option value="Pendiente" selected="@(item.Estado == "Pendiente")">🟡 Pendiente</option>
                                            <option value="Confirmada" selected="@(item.Estado == "Confirmada")">🔵 Confirmada</option>
                                            <option value="En Curso" selected="@(item.Estado == "En Curso")">🟣 En Curso</option>
                                            <option value="Completada" selected="@(item.Estado == "Completada")">🟢 Completada</option>
                                            <option value="Cancelada" selected="@(item.Estado == "Cancelada")">🔴 Cancelada</option>
                                            <option value="No Asistió" selected="@(item.Estado == "No Asistió")">⚪ No Asistió</option>
                                        </select>
                                    </form>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="RedactarNota" asp-route-citaId="@item.CitaId" 
                                       class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-sm hover-elevate @(item.TieneNotaClinica ? "border-success text-success fw-medium" : "")">
                                        @(item.TieneNotaClinica ? "✔ Ver Nota" : "📝 Redactar Nota")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="fs-1 text-muted opacity-50 mb-2">📋</div>
                <h5 class="fw-bold text-secondary">No tienes consultas agendadas por el momento</h5>
                <p class="text-muted small">Los nuevos turnos reservados por los estudiantes aparecerán automáticamente aquí.</p>
            </div>
        }
    </div>
</div>

<style>
    .hover-elevate {
        transition: transform 0.2s ease, background-color 0.2s ease;
    }
    .hover-elevate:hover {
        transform: translateY(-2px);
        background-color: var(--azul-serenidad) !important;
        color: #fff !important;
        border-color: var(--azul-serenidad) !important;
    }
</style>