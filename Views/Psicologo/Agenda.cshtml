@model IEnumerable<StarMindsMVC.Models.AgendaPsicologoViewModel>
@{
    ViewData["Title"] = "Agenda de Consultas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold" style="color: #2A6F97;">Agenda Terapéutica</h2>
        <p class="text-muted mb-0">Especialista: <strong>@ViewBag.NombrePsicologo</strong></p>
    </div>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fecha y Horario</th>
                    <th>Paciente (Alias)</th>
                    <th>Modalidad</th>
                    <th>Motivo Orientativo</th>
                    <th>Estado de Cita</th>
                    <th class="text-center">Expediente Clínico</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.FechaHoraInicio.ToString("dd/MM/yyyy")</strong><br />
                            <span class="text-muted small">@item.FechaHoraInicio.ToString("HH:mm") - @item.FechaHoraFin.ToString("HH:mm")</span>
                        </td>
                        <td>
                            <span class="badge px-3 py-2" style="background-color: #2A6F97; font-size: 0.9rem;">
                                @item.AliasEstudiante
                            </span>
                        </td>
                        <td>
                            @if (item.Modalidad == "Virtual")
                            {
                                <span class="badge bg-info text-dark">Virtual</span>
                                @if (!string.IsNullOrEmpty(item.EnlaceVideollamada))
                                {
                                    <br /><a href="@item.EnlaceVideollamada" target="_blank" class="small text-decoration-none">Abrir Sesión</a>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary">Presencial</span>
                            }
                        </td>
                        <td>
                            <span class="small text-muted">@(string.IsNullOrEmpty(item.MotivoConsulta) ? "Sin motivo especificado" : item.MotivoConsulta)</span>
                        </td>
                        <td>
                            <form asp-action="CambiarEstado" method="post" class="d-inline">
                                <input type="hidden" name="citaId" value="@item.CitaId" />
                                <select name="nuevoEstado" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="Pendiente" selected="@(item.Estado == "Pendiente")">Pendiente</option>
                                    <option value="Confirmada" selected="@(item.Estado == "Confirmada")">Confirmada</option>
                                    <option value="En Curso" selected="@(item.Estado == "En Curso")">En Curso</option>
                                    <option value="Completada" selected="@(item.Estado == "Completada")">Completada</option>
                                    <option value="Cancelada" selected="@(item.Estado == "Cancelada")">Cancelada</option>
                                    <option value="No Asistio" selected="@(item.Estado == "No Asistio")">No Asistió</option>
                                </select>
                            </form>
                        </td>
                        <td class="text-center">
                            <a asp-action="RedactarNota" asp-route-citaId="@item.CitaId" 
                               class="btn btn-sm @(item.TieneNotaClinica ? "btn-outline-success" : "btn-outline-primary")">
                                @(item.TieneNotaClinica ? "Ver/Editar Nota" : "+ Redactar Nota")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>  