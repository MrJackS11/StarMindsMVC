@model StarMindsMVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Acceso Seguro - Star Minds";
}

<div class="cosmos-container d-flex align-items-center justify-content-center py-5 px-3">
    <!-- Destellos Estelares de Fondo -->
    <div class="star-sparkle" style="top: 15%; left: 18%; font-size: 1.8rem; color: #C7F9CC;">✦</div>
    <div class="star-sparkle" style="top: 25%; right: 20%; font-size: 1.3rem; color: #FFF385;">✦</div>
    <div class="star-sparkle" style="bottom: 20%; left: 22%; font-size: 1.5rem; color: #E8D7F1;">✦</div>
    <div class="star-sparkle" style="bottom: 15%; right: 25%; font-size: 2rem; color: #C7F9CC;">✦</div>

    <div class="card glass-card p-4 p-md-5 shadow-lg border-0 text-white" style="width: 100%; max-width: 460px;">
        <div class="text-center mb-4">
            <span class="fs-1 d-block mb-1 text-warning" style="text-shadow: 0 0 15px rgba(255,243,133,0.5);">✦</span>
            <h2 class="fw-bold mb-1 tracking-wide text-white">Star Minds</h2>
            <p class="small text-white-50 mb-0">Ingresa a tu portal de orientación y citas</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 px-3 small border-0 rounded-3 text-center" style="background-color: rgba(230, 57, 70, 0.85); color: #fff;">
                @Html.ValidationSummary(false, "", new { @class = "mb-0 list-unstyled" })
            </div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Correo" class="form-label small fw-semibold text-white-50">Correo Electrónico *</label>
                <input asp-for="Correo" class="form-control glass-input" placeholder="ejemplo@upds.edu.bo" required autocomplete="username" />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold text-white-50">Contraseña *</label>
                <input asp-for="Password" type="password" class="form-control glass-input" placeholder="••••••••" required autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="Recordarme" class="form-check-input bg-transparent border-secondary" type="checkbox" id="recordar" />
                    <label asp-for="Recordarme" class="form-check-label small text-white-50" for="recordar">Recordar mi sesión</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 py-2 fw-semibold shadow">
                Ingresar al Portal
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top border-white border-opacity-10">
            <p class="small text-white-50 mb-0">
                ¿No tienes cuenta aún? 
                <a asp-action="Register" class="text-decoration-none fw-bold" style="color: var(--verde-menta);">
                    Regístrate con tu Alias
                </a>
            </p>
        </div>
    </div>
</div>

<style>
    .cosmos-container {
        position: relative;
        min-height: 86vh;
        background: radial-gradient(circle at 50% 30%, #1A3A54 0%, #101B2B 55%, #080D15 100%);
        overflow: hidden;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .star-sparkle {
        position: absolute;
        opacity: 0.6;
        animation: pulseStar 3s infinite alternate ease-in-out;
        pointer-events: none;
    }

    @@keyframes pulseStar {
        0% { transform: scale(0.85); opacity: 0.3; }
        100% { transform: scale(1.15); opacity: 0.85; }
    }

    .glass-card {
        background: rgba(22, 28, 38, 0.72) !important;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 22px;
    }

    .glass-input {
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.18) !important;
        color: #fff !important;
        border-radius: 10px;
        padding: 10px 14px;
        transition: all 0.25s ease;
    }

    .glass-input:focus {
        background: rgba(255, 255, 255, 0.13) !important;
        border-color: var(--verde-menta) !important;
        box-shadow: 0 0 12px rgba(82, 135, 136, 0.35) !important;
    }

    .glass-input::placeholder {
        color: rgba(255, 255, 255, 0.35);
    }

    .btn-primary-custom {
        background-color: var(--azul-serenidad) !important;
        border: 1px solid rgba(255,255,255,0.15) !important;
        color: #fff !important;
        border-radius: 10px;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .btn-primary-custom:hover {
        background-color: #235d7f !important;
        transform: translateY(-2px);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}