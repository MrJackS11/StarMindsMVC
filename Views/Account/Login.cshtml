@model StarMindsMVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Acceso Seguro";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0 rounded-4" style="border-top: 6px solid #2A6F97 !important;">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold" style="color: #2A6F97;">Star Minds</h3>
                    <p class="text-muted small">Ingresa a tu portal de orientación y citas</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label fw-semibold text-secondary">Correo Electrónico</label>
                        <input asp-for="Correo" class="form-control py-2" placeholder="ejemplo@upds.edu.bo" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold text-secondary">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control py-2" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="Recordarme" id="recordarmeCheck">
                        <label class="form-check-label text-muted small" for="recordarmeCheck">
                            Recordar mi sesión
                        </label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn text-white py-2 fw-semibold shadow-sm" style="background-color: #2A6F97; border-radius: 8px;">
                            Ingresar
                        </button>
                    </div>

                    <div class="text-center mt-3 pt-2 border-top">
                        <span class="text-muted small">¿No tienes cuenta aún?</span>
                        <a asp-action="Register" class="fw-semibold text-decoration-none ms-1" style="color: #528788;">
                            Regístrate con tu Alias
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}