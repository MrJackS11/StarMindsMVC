<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Star Minds Gabinete Psicológico</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --azul-serenidad: #2A6F97;
            --verde-menta: #52B788;
            --gris-claro: #F8F9FA;
            --gris-carbon: #212529;
            --rojo-alerta: #E63946;
        }
        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--gris-claro);
            color: var(--gris-carbon);
        }
        .navbar-starminds {
            background-color: #ffffff;
            border-bottom: 2px solid #e9ecef;
        }
        .nav-link {
            font-weight: 500;
            color: #495057 !important;
        }
        .nav-link:hover {
            color: var(--azul-serenidad) !important;
        }
        .btn-menta {
            background-color: var(--verde-menta);
            color: white;
            font-weight: 500;
            border-radius: 8px;
            padding: 8px 18px;
        }
        .btn-menta:hover {
            background-color: #40916c;
            color: white;
        }
        .btn-outline-serenidad {
            border: 2px solid var(--azul-serenidad);
            color: var(--azul-serenidad);
            font-weight: 500;
            border-radius: 8px;
            padding: 7px 16px;
        }
        .btn-outline-serenidad:hover {
            background-color: var(--azul-serenidad);
            color: white;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-starminds py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index" style="color: var(--azul-serenidad); font-size: 1.3rem;">
                    <span>✦ Star Minds</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContenido">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContenido">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacidad y Anonimato</a>
                        </li>

                        @* Vistas exclusivas de Estudiantes *@
                        @if (User.IsInRole("Estudiante"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold" asp-controller="Citas" asp-action="Index" style="color: var(--verde-menta) !important;">
                                    Mis Citas
                                </a>
                            </li>
                        }

                        @* Vistas exclusivas del Especialista / Terapeuta (Sprint 3) *@
                        @if (User.IsInRole("Psicologo"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-primary" asp-controller="Psicologo" asp-action="Agenda">
                                    📋 Agenda Terapéutica
                                </a>
                            </li>
                        }
                    </ul>
                    
                    @* Control de sesión *@
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <span class="fw-semibold px-3 py-1 rounded-pill border" style="background-color: #e8f1f5; color: var(--azul-serenidad); font-size: 0.9rem;">
                                ✦ @User.Identity.Name
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                    Cerrar Sesión
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn btn-outline-serenidad" asp-controller="Account" asp-action="Login">Iniciar Sesión</a>
                            <a class="btn btn-menta shadow-sm" asp-controller="Account" asp-action="Register">Registro Anónimo</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
        <div class="container">
            &copy; 2026 - Star Minds | Gabinete de Apoyo Psicológico Universitario - UPDS Cochabamba
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>