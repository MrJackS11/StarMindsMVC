@model IEnumerable<StarMindsMVC.Models.Cita>
@{
    ViewData["Title"] = "Mis Citas de Apoyo - Star Minds";
}

<!-- CABECERA NOCTURNA ESTRELLADA UNIFICADA -->
<section class="w-100 py-4 py-md-5 px-3 px-lg-5 text-white mb-4 position-relative overflow-hidden" 
         style="background: radial-gradient(circle at 75% 30%, #2A6F97 0%, #152238 65%, #0B1320 100%); border-bottom: 1px solid rgba(255,255,255,0.08);">
    
    <div style="position: absolute; top: 15%; right: 35%; font-size: 1.6rem; color: #FFF385; opacity: 0.7;">✦</div>
    <div style="position: absolute; bottom: 20%; right: 15%; font-size: 1.3rem; color: #C7F9CC; opacity: 0.65;">✦</div>

    <div class="container-fluid px-lg-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div data-aos="fade-right">
                <span class="badge mb-2 px-3 py-2 text-white rounded-pill fw-semibold shadow-sm" style="background-color: var(--verde-menta); font-size: 0.85rem;">
                    ✦ Portal Confidencial del Estudiante
                </span>
                <h1 class="display-6 fw-bold mb-1 text-white" style="font-size: clamp(1.6rem, 3.5vw, 2.4rem);">
                    Mis Citas de Apoyo
                </h1>
                <p class="text-white-50 mb-0 fs-5">
                    Historial y seguimiento discreto de tus sesiones de orientación psicológica.
                </p>
            </div>
            <div data-aos="fade-left">
                <a asp-action="Agendar" class="btn btn-lg text-white shadow d-flex align-items-center gap-2 rounded-pill px-4 py-2.5 fw-semibold" 
                   style="background-color: var(--verde-menta);">
                    <span>✦ Agendar Nueva Cita</span>
                </a>
            </div>
        </div>
    </div>
</section>

<div class="container-fluid px-3 px-lg-5 py-3">
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 mb-4 shadow-sm border-0" 
             style="background-color: #E2F4EE; color: #155743;" role="alert" data-aos="fade-down">
            <strong>✦ Notificación:</strong> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @{ int delay = 50; }
            @foreach (var cita in Model)
            {
                string badgeBg = "#E1F0FA";
                string badgeColor = "#0E486B";
                string borderColor = "var(--azul-serenidad)";

                if (cita.Estado == "Pendiente")
                {
                    badgeBg = "#FEF3C7";
                    badgeColor = "#92400E";
                    borderColor = "#F59E0B";
                }
                else if (cita.Estado == "Confirmada")
                {
                    badgeBg = "#E1F0FA";
                    badgeColor = "#0E486B";
                    borderColor = "var(--azul-serenidad)";
                }
                else if (cita.Estado == "Completada")
                {
                    badgeBg = "#E2F4EE";
                    badgeColor = "#155743";
                    borderColor = "var(--verde-menta)";
                }
                else if (cita.Estado == "Cancelada")
                {
                    badgeBg = "#F3F4F6";
                    badgeColor = "#6B7280";
                    borderColor = "#9CA3AF";
                }

                <div class="col-12 col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="@delay">
                    <div class="card h-100 border-0 shadow-sm rounded-4 bg-white p-4 d-flex flex-column justify-content-between tilt-card"
                         style="border-top: 5px solid @borderColor !important;">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge px-3 py-1.5 rounded-pill fw-semibold" style="background-color: #F0F4F8; color: var(--azul-serenidad); font-size: 0.82rem;">
                                    @(cita.Modalidad == "Presencial" ? "🏢 Presencial" : "💻 Virtual")
                                </span>
                                <span class="badge px-3 py-1.5 rounded-pill fw-semibold" style="background-color: @badgeBg; color: @badgeColor; font-size: 0.82rem;">
                                    ✦ @cita.Estado
                                </span>
                            </div>

                            <h5 class="fw-bold mb-1 text-dark">
                                @(cita.Psicologo != null ? cita.Psicologo.NombreCompleto : "Especialista del Centro")
                            </h5>
                            <p class="text-muted small mb-3">
                                @(cita.Psicologo != null ? cita.Psicologo.Especialidad : "Gabinete Star Minds UPDS")
                            </p>

                            <div class="p-3 rounded-3 bg-light border mb-3 small">
                                <div class="mb-1 text-secondary">
                                    📅 <strong>Fecha:</strong> @cita.FechaHoraInicio.ToString("dddd, dd MMMM yyyy")
                                </div>
                                <div class="text-secondary">
                                    ⏰ <strong>Horario:</strong> @cita.FechaHoraInicio.ToString("HH:mm") - @cita.FechaHoraFin.ToString("HH:mm") (45 min)
                                </div>
                                @if (!string.IsNullOrEmpty(cita.MotivoConsulta))
                                {
                                    <div class="mt-2 pt-2 border-top text-muted text-truncate" title="@cita.MotivoConsulta">
                                        💬 <em>"@cita.MotivoConsulta"</em>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Acciones y Estados de la Cita -->
                        <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                            @if (cita.Modalidad == "Virtual" && cita.Psicologo != null && !string.IsNullOrEmpty(cita.Psicologo.EnlaceVideollamada) && cita.Estado != "Cancelada")
                            {
                                <a href="@cita.Psicologo.EnlaceVideollamada" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                    Enlace de Sesión ↗
                                </a>
                            }
                            else
                            {
                                <small class="text-muted">Gabinete Presencial UPDS</small>
                            }

                            @if (cita.Estado == "Pendiente")
                            {
                                <form asp-action="Cancelar" method="post" onsubmit="return confirm('¿Estás seguro de que deseas anular esta cita? El turno quedará libre para otro compañero.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@cita.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                                        Anular Turno
                                    </button>
                                </form>
                            }
                            else if (cita.Estado == "Completada")
                            {
                                <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-2.5 py-1 small">
                                    ✓ Sesión Concluida
                                </span>
                            }
                        </div>
                    </div>
                </div>
                delay += 75;
            }
        </div>
    }
    else
    {
        <!-- ESTADO VACÍO ELEGANTE -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white mx-auto my-5 tilt-card" style="max-width: 650px;" data-aos="zoom-in">
            <div class="mb-3" style="font-size: 3.5rem; color: var(--morado-calma);">✦</div>
            <h3 class="fw-bold text-dark mb-2">No tienes citas programadas por el momento.</h3>
            <p class="text-muted mb-4 fs-6" style="max-width: 480px; margin: 0 auto;">
                Recuerda que solicitar orientación es un paso seguro, 100% anónimo y gratuito con el equipo de psicólogos de la UPDS.
            </p>
            <div class="d-flex justify-content-center">
                <a asp-action="Agendar" class="btn px-4 py-2.5 text-white shadow rounded-pill fw-semibold" style="background-color: var(--verde-menta);">
                    ✦ Reservar una Sesión Confidencial
                </a>
            </div>
        </div>
    }
</div>