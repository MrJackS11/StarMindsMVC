@model IEnumerable<StarMindsMVC.Models.Cita>

@{
    ViewData["Title"] = "Mis Citas Confidenciales";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Mis Citas de Apoyo</h2>
            <p class="text-muted mb-0">Gestión privada de tus sesiones psicológicas.</p>
        </div>
        <a asp-action="Agendar" class="btn text-white px-4 py-2" style="background-color: #2D6A4F; border-radius: 8px;">
            + Agendar Nueva Cita
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5" style="border-radius: 12px;">
            <div class="card-body">
                <h5 class="text-muted">No tienes citas programadas por el momento.</h5>
                <p class="text-secondary">Recuerda que este espacio es 100% confidencial y gratuito.</p>
                <a asp-action="Agendar" class="btn btn-outline-success mt-2">Reservar una sesión</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive bg-white shadow-sm rounded-3 p-3">
            <table class="table align-middle table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Fecha y Hora</th>
                        <th>Duración</th>
                        <th>Especialista</th>
                        <th>Modalidad</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>45 min (con 15 min pausa)</td>
                            <td>@(item.Psicologo?.NombreCompleto ?? "Asignado")</td>
                            <td>
                                <span class="badge bg-secondary">@item.Modalidad</span>
                            </td>
                            <td>
                                @if (item.Estado == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                }
                                else if (item.Estado == "Confirmada")
                                {
                                    <span class="badge bg-success">Confirmada</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@item.Estado</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.Estado == "Pendiente")
                                {
                                    <form asp-action="Cancelar" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de cancelar esta sesión?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Cancelar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>