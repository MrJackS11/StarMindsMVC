@model StarMindsMVC.Models.AgendarCitaViewModel
@{
    ViewData["Title"] = "Agendar Cita Discreta - Star Minds";
}

<!-- CABECERA NOCTURNA ESTRELLADA UNIFICADA -->
<section class="w-100 py-4 py-md-5 px-3 px-lg-5 text-white mb-4 position-relative overflow-hidden" 
         style="background: radial-gradient(circle at 75% 25%, #2A6F97 0%, #152238 65%, #0B1320 100%); border-bottom: 1px solid rgba(255,255,255,0.08);">
    
    <div style="position: absolute; top: 20%; right: 20%; font-size: 1.6rem; color: #FFF385; opacity: 0.7;">✦</div>
    <div style="position: absolute; bottom: 25%; right: 10%; font-size: 1.3rem; color: #C7F9CC; opacity: 0.65;">✦</div>

    <div class="container-fluid px-lg-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div data-aos="fade-right">
                <span class="badge mb-2 px-3 py-2 text-white rounded-pill fw-semibold shadow-sm" style="background-color: var(--verde-menta); font-size: 0.85rem;">
                    ✦ Protocolo Discreto Star Minds
                </span>
                <h1 class="display-6 fw-bold mb-1 text-white" style="font-size: clamp(1.6rem, 3.5vw, 2.4rem);">
                    Agendar Sesión de Apoyo
                </h1>
                <p class="text-white-50 mb-0" style="font-size: 1.05rem; max-width: 680px;">
                    Tu reserva se vinculará únicamente a tu alias confidencial. Los terapeutas no tienen acceso a tu identidad académica real.
                </p>
            </div>
            
            <div class="d-none d-md-block text-end" data-aos="fade-left">
                <span class="badge rounded-pill px-3 py-2 text-white d-inline-flex align-items-center gap-2 shadow-sm" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.22);">
                    🔒 100% Anónimo y Gratuito
                </span>
            </div>
        </div>
    </div>
</section>

<!-- CONTENEDOR DEL FORMULARIO CON ANIMACIÓN DE ENTRADA Y PASOS -->
<div class="container-fluid px-3 px-lg-5 py-2">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-5 mb-5 mx-auto" 
         style="max-width: 860px; border-top: 5px solid var(--verde-menta) !important;"
         data-aos="zoom-in" data-aos-duration="700">
        
        <!-- STEPPER VISUAL ORIENTATIVO -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom text-muted small">
            <div class="d-flex align-items-center gap-2 text-dark fw-bold">
                <span class="rounded-circle d-inline-flex align-items-center justify-content-center text-white" style="width: 26px; height: 26px; background-color: var(--verde-menta); font-size: 0.8rem;">1</span>
                <span>Especialista & Fecha</span>
            </div>
            <div class="d-none d-sm-block text-muted">➔</div>
            <div class="d-flex align-items-center gap-2 text-dark fw-bold">
                <span class="rounded-circle d-inline-flex align-items-center justify-content-center text-white" style="width: 26px; height: 26px; background-color: var(--azul-serenidad); font-size: 0.8rem;">2</span>
                <span>Bloque de 45 min</span>
            </div>
            <div class="d-none d-sm-block text-muted">➔</div>
            <div class="d-flex align-items-center gap-2 text-muted">
                <span class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light border text-muted" style="width: 26px; height: 26px; font-size: 0.8rem;">3</span>
                <span>Confirmación</span>
            </div>
        </div>

        <form asp-action="Agendar" method="post" id="formAgendar">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 small border-0 rounded-3 mb-4 shadow-sm" style="background-color: rgba(230, 57, 70, 0.95); color: #fff;">
                    @Html.ValidationSummary(false, "", new { @class = "mb-0 list-unstyled" })
                </div>
            }

            <!-- Especialista y Fecha -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label asp-for="PsicologoId" class="form-label fw-semibold small text-dark">Especialista Terapeuta *</label>
                    <select asp-for="PsicologoId" class="form-select py-2.5 border-secondary border-opacity-25 rounded-3 shadow-none" id="selectPsicologo" onchange="actualizarHorarios()" required>
                        <option value="">Selecciona un profesional...</option>
                        @if (Model.PsicologosDisponibles != null)
                        {
                            foreach (var p in Model.PsicologosDisponibles)
                            {
                                <option value="@p.Id" selected="@(p.Id == Model.PsicologoId ? "selected" : null)">
                                    @p.NombreCompleto - @p.Especialidad
                                </option>
                            }
                        }
                    </select>
                    <span asp-validation-for="PsicologoId" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Fecha" class="form-label fw-semibold small text-dark">Fecha de Consulta *</label>
                    <input asp-for="Fecha" type="date" class="form-control py-2.5 border-secondary border-opacity-25 rounded-3 shadow-none" 
                           id="inputFecha"
                           value="@Model.Fecha.ToString("yyyy-MM-dd")" 
                           min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" 
                           onchange="actualizarHorarios()" required />
                    <span asp-validation-for="Fecha" class="text-danger small"></span>
                </div>
            </div>

            <!-- Accesos Rápidos de Días Próximos -->
            <div class="mb-4">
                <span class="text-muted small fw-semibold d-block mb-2">✦ Días sugeridos para agendar:</span>
                <div class="d-flex flex-wrap gap-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var diaSugerido = DateTime.Today.AddDays(i);
                        if (diaSugerido.DayOfWeek != DayOfWeek.Sunday)
                        {
                            string fechaStr = diaSugerido.ToString("yyyy-MM-dd");
                            bool esActual = Model.Fecha.Date == diaSugerido.Date;
                            <button type="button" 
                                    class="btn btn-sm rounded-pill px-3 py-1.5 fw-medium quick-date-btn @(esActual ? "active-date" : "btn-light border text-muted")"
                                    onclick="seleccionarFechaRapida('@fechaStr')">
                                @diaSugerido.ToString("ddd dd MMM")
                            </button>
                        }
                    }
                </div>
            </div>

            <!-- Horarios Disponibles -->
            <div class="mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                    <label class="form-label fw-semibold small text-dark mb-0">
                        Horarios Disponibles (45 min sesión + 15 min pausa)
                    </label>
                    <span class="badge px-3 py-1 rounded-pill fw-normal text-white shadow-sm" style="background-color: var(--verde-menta); font-size: 0.78rem;">
                        ✦ Verde Menta: Turno Libre
                    </span>
                </div>

                <input type="hidden" asp-for="HoraInicio" id="horaInicioInput" value="@(Model.HoraInicio != TimeSpan.Zero ? Model.HoraInicio.ToString(@"hh\:mm") : "")" required />

                <div class="row g-2 pt-1" id="bloquesHorarios">
                    @if (Model.HorariosDisponibles != null && Model.HorariosDisponibles.Any())
                    {
                        foreach (var turno in Model.HorariosDisponibles)
                        {
                            string horaStr = turno.ToString(@"hh\:mm");
                            bool esSeleccionado = Model.HoraInicio == turno;
                            <div class="col-6 col-sm-4 col-md-3">
                                <button type="button" 
                                        class="btn btn-bloque w-100 py-2.5 fw-semibold shadow-sm @(esSeleccionado ? "bloque-activo" : "")" 
                                        onclick="seleccionarTurno(this, '@horaStr')">
                                    @horaStr
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="alert alert-warning py-3 small border-0 rounded-3 text-center mb-0 shadow-sm" style="background-color: #FFF9E6; border-left: 4px solid #F4A261 !important;">
                                No hay turnos disponibles para este especialista en la fecha seleccionada. Por favor elige otro día u otro profesional.
                            </div>
                        </div>
                    }
                </div>
                <span asp-validation-for="HoraInicio" class="text-danger small d-block mt-2"></span>
            </div>

            <!-- Modalidad -->
            <div class="mb-4 p-3 rounded-3" style="background-color: #F8F9FA;">
                <label class="form-label fw-semibold small text-dark d-block mb-2">Modalidad de la Sesión *</label>
                <div class="d-flex flex-wrap gap-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Modalidad" id="modPresencial" value="Presencial" checked>
                        <label class="form-check-label small fw-semibold text-dark" for="modPresencial">
                            🏢 Presencial (Gabinete UPDS - Sede Cochabamba)
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Modalidad" id="modVirtual" value="Virtual">
                        <label class="form-check-label small fw-semibold text-dark" for="modVirtual">
                            💻 Virtual (Videollamada en enlace privado)
                        </label>
                    </div>
                </div>
            </div>

            <!-- Motivo de Consulta -->
            <div class="mb-4">
                <label asp-for="MotivoConsulta" class="form-label fw-semibold small text-dark">
                    Motivo orientativo o cómo te sientes hoy (Opcional y confidencial)
                </label>
                <textarea asp-for="MotivoConsulta" class="form-control border-secondary border-opacity-25 rounded-3 p-3 shadow-none" 
                          rows="3" maxlength="500" placeholder="Ej. Me siento abrumado por las entregas de fin de módulo, tengo dificultades para conciliar el sueño o requiero orientación..."></textarea>
                <span asp-validation-for="MotivoConsulta" class="text-danger small"></span>
            </div>

            <!-- Acciones -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-3 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2.5 rounded-pill text-center order-2 order-sm-1 fw-medium">
                    ← Volver a Mis Citas
                </a>
                <button type="submit" class="btn text-white px-5 py-2.5 rounded-pill fw-semibold shadow order-1 order-sm-2" 
                        style="background-color: var(--verde-menta);">
                    ✦ Confirmar Cita Anónima
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .btn-bloque {
        background-color: #528788;
        color: #ffffff;
        border: 2px solid #528788;
        border-radius: 10px;
        transition: all 0.22s ease-in-out;
    }

    .btn-bloque:hover {
        background-color: #436e6f;
        border-color: #436e6f;
        color: #ffffff;
        transform: translateY(-2px);
    }

    .bloque-activo {
        background-color: #17324D !important;
        border-color: #17324D !important;
        color: #ffffff !important;
        box-shadow: 0 0 0 4px rgba(42, 111, 151, 0.25) !important;
        transform: scale(1.02);
        animation: pulseSelection 0.3s ease;
    }

    @@keyframes pulseSelection {
        0% { transform: scale(0.96); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1.02); }
    }

    .quick-date-btn {
        transition: all 0.2s ease;
    }
    .quick-date-btn:hover {
        background-color: #e8f4f8;
        color: var(--azul-serenidad) !important;
    }
    .active-date {
        background-color: var(--azul-serenidad) !important;
        color: #ffffff !important;
        border-color: var(--azul-serenidad) !important;
        box-shadow: 0 4px 10px rgba(42, 111, 151, 0.25) !important;
    }
</style>

@section Scripts {
    <script>
        function seleccionarTurno(boton, hora) {
            document.querySelectorAll('.btn-bloque').forEach(b => b.classList.remove('bloque-activo'));
            boton.classList.add('bloque-activo');
            document.getElementById('horaInicioInput').value = hora;
        }

        function seleccionarFechaRapida(fechaStr) {
            document.getElementById('inputFecha').value = fechaStr;
            actualizarHorarios();
        }

        function actualizarHorarios() {
            const psicologoId = document.getElementById('selectPsicologo').value;
            const fecha = document.getElementById('inputFecha').value;

            if (!psicologoId || !fecha) return;

            window.location.href = `/Citas/Agendar?psicologoId=${psicologoId}&fecha=${fecha}`;
        }
    </script>
}